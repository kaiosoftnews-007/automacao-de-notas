# Endereço do Supabase da automação (não mude)
SUPABASE_URL=https://ankmyrxwxaevxmorfedd.supabase.co

# Chave SECRETA do Supabase: Project Settings > API Keys > Secret keys (começa com sb_secret_)
# Ela fica só neste computador. Não mande para ninguém.
SUPABASE_SECRET_KEY=COLE_AQUI_A_CHAVE_SECRETA

# Nome deste computador no painel (opcional)
MAQUINA=PC do escritório

# Quanto tempo esperar alguém clicar na verificação da Sefaz (minutos)
ESPERA_VERIFICACAO_MIN=10

# Quanto tempo esperar a fila de downloads da Sefaz (minutos)
ESPERA_FILA_MIN=30
